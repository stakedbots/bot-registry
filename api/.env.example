# Bot Registry API

# Listen port
PORT=3000

# x402 — receiving address for USDC payments. Use jorgemora.eth for now.
PAY_TO=0xdaBC8b82e3a3c637a14E7c2F9F35A7cE83bAaCab

# Network for the x402 paywall — base-sepolia or base
NETWORK=base-sepolia

# Optional: override facilitator URL.
# Default for base-sepolia: https://x402.org/facilitator (free).
# For base mainnet you need CDP API keys.
FACILITATOR_URL=

# DB
DATABASE_URL=
