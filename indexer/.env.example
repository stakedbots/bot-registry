# Bot Registry Indexer config

# --- Chain ---
# baseSepolia (84532) | base (8453)
CHAIN=baseSepolia
RPC_URL=https://sepolia.base.org

# Registry deployment to index. Pulled from contracts/addresses/<network>.json
# but can be overridden here. Lowercase hex.
REGISTRY_ADDRESS=0xe11571195aB3c7e629E4c74C6018125Bc57f01F1

# Block to start indexing from on first run (cursor empty).
# Use the contract creation block, or one a few blocks before.
START_BLOCK=42607500

# How many blocks per getLogs call. Public RPCs cap around 10000.
BATCH_SIZE=2000

# --- DB ---
# DATABASE_URL=postgres://supabase_admin:<password>@10.0.2.2:5432/postgres
DATABASE_URL=

# --- Loop ---
# Polling interval in seconds when running as daemon.
POLL_INTERVAL_SECONDS=30
