# The bot's trading wallet private key. The wallet registers ITSELF:
# operator = trading wallet. Needs ≥ 10 USDC + ~0.0005 ETH for gas on Base.
HOT_WALLET_PRIVATE_KEY=

# Identity you commit to (hashed on-chain, can't be rewritten later)
BOT_NAME=my-bot
BOT_STRATEGY=EMA 12/26 crossover on cbBTC/USDC, 20min ticks
BOT_BENCHMARK=HODL 50/50 USDC/cbBTC

# Optional
# STAKE_USDC=10            # default = contract minStake (10 USDC)
# MANIFEST_URI=ipfs://…    # default = inline:<BOT_NAME>-self-v1
# ATTEST_EPOCH=2026-06-09  # default = today UTC
# RPC_URL=https://…        # default = viem's public Base RPC
# BOT_ID=                  # only for attest/unlink edge cases
